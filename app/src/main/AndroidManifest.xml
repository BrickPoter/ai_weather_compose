<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AI_weather">
        <service
            android:name="com.mosi.mosc.ai_weather.WeatherAIDLServices"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mosi.mosc.ai_weather.APP_AIDL_SERVICE" />
            </intent-filter>
        </service>

        <receiver android:name=".WakeUpReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.mosi.mosc.ai_weather.WAKE_UP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>