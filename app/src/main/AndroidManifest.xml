        android:supportsRtl="true"
        android:theme="@style/Theme.AI_weather" >
        <service android:name="com.mosi.mosc.ai_weather.WeatherAIDLServices"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.mosi.mosc.ai_weather.APP_AIDL_SERVICE" />
                <category android:name="com.mosi.mosc.ai_aidl_weather"/>
            </intent-filter>
        </service>

    </application>

</manifest>