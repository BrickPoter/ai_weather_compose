<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="@string/highestTemp"
        android:id="@+id/text_highest_temp"
        android:layout_width="wrap_content"
            android:layout_height="136dp"
        style="@style/Title_1_Regular"
        android:alpha="0.9"
        android:textColor="@color/Fill_Always_Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:text="@string/lowestTemp"
        android:id="@+id/text_lowest_temp"
        android:layout_width="wrap_content"
        android:layout_height="136dp"
        style="@style/Title_1_Regular"
        android:alpha="0.6"
        android:textColor="@color/Fill_Always_Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_highest_temp"/>

    <TextView
        android:text="@string/condition"
        android:id="@+id/text_weather_status"
        android:layout_width="360dp"
        android:layout_height="56dp"
        style="@style/Content_2_Regular"
        android:alpha="0.6"
        android:textColor="@color/Fill_Always_Dark"
        app:layout_constraintStart_toStartOf="@id/text_highest_temp"
        app:layout_constraintTop_toBottomOf="@id/text_highest_temp"/>

    <ImageView
        android:src="@drawable/clear_cloudy_day"
        android:id="@+id/image_weather"
        android:layout_width="268dp"
        android:layout_height="200dp"
        android:layout_marginStart="376dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>