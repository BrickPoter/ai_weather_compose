<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="730dp"
    android:layout_height="1064dp"
    android:orientation="vertical"
    android:background="@drawable/clear"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.mosi.mosc.launcher.ai_weather.ui.CardHeaderLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="40dp"/>

    <com.mosi.mosc.launcher.ai_weather.ui.ForecastInfoRecycler
        android:id="@+id/forecast"
        android:layout_width="618dp"
        android:layout_height="728dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="40dp" />


    <com.mosi.mosc.launcher.ai_weather.ui.WarnInfoRecycler
        android:id="@+id/warn"
        android:background="@drawable/bg_rect_alert_info"
        android:layout_width="634dp"
        android:layout_height="96dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="48dp"/>

    <com.mosi.mosc.launcher.ai_weather.ui.Indicator
        android:paddingTop="12dp"
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:selectedWidth="24dp"/>



</LinearLayout>