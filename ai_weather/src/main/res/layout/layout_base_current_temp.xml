<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    
    <LinearLayout
        android:id="@+id/frame_current_temp"
        android:layout_width="wrap_content"
        android:layout_height="160dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:text="@string/highestTemp"
            android:id="@+id/text_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="160dp"
            style="@style/Title_2_Regular"
            android:textColor="@color/Fill_Always_Dark"
            android:alpha="0.9"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/symbol_temperature"
            android:layout_marginTop="32dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>


    <TextView
        android:text="@string/temp_high_low"
        android:id="@+id/text_highest_lowest_temp"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        style="@style/Title_3_Regular"
        android:textColor="@color/Fill_Always_Dark"
        android:alpha="0.6"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="@id/text_weather_status"
        app:layout_constraintTop_toTopOf="@id/text_weather_status" />

    <TextView
        android:text="@string/condition"
        android:id="@+id/text_weather_status"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        style="@style/Content_2_Regular"
        android:textColor="@color/Fill_Always_Dark"
        android:alpha="0.6"
        android:layout_marginStart="188dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="@id/frame_current_temp"
        app:layout_constraintTop_toTopOf="@id/frame_current_temp"/>

    <ImageView
        android:src="@drawable/clear_cloudy_day"
        android:id="@+id/image_weather"
        android:layout_width="268dp"
        android:layout_height="200dp"
        android:layout_marginStart="376dp"
        app:layout_constraintStart_toStartOf="@id/frame_current_temp"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>