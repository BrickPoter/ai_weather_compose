<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/choos_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_1_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/item_1_title_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="空气质量" />

        <TextView
            android:id="@+id/item_1_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_1_title_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="紫外线" />

        <TextView
            android:id="@+id/item_1_message_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_1_title_1"
            app:layout_constraintStart_toStartOf="@+id/item_1_title_1"
            app:layout_constraintTop_toBottomOf="@+id/item_1_title_1"
            tools:text="良好" />

        <TextView
            android:id="@+id/item_1_message_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_1_title_2"
            app:layout_constraintStart_toStartOf="@+id/item_1_title_2"
            app:layout_constraintTop_toBottomOf="@+id/item_1_title_2"
            tools:text="中等" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_2_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/item_2_title_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="降水概率" />

        <TextView
            android:id="@+id/item_2_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_2_title_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="穿衣指数" />

        <TextView
            android:id="@+id/item_2_message_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_2_title_1"
            app:layout_constraintStart_toStartOf="@+id/item_2_title_1"
            app:layout_constraintTop_toBottomOf="@+id/item_2_title_1"
            tools:text="35%" />

        <TextView
            android:id="@+id/item_2_message_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_2_title_2"
            app:layout_constraintStart_toStartOf="@+id/item_2_title_2"
            app:layout_constraintTop_toBottomOf="@+id/item_2_title_2"
            tools:text="很弱" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_3_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/item_3_title_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="风力风向" />

        <TextView
            android:id="@+id/item_3_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_3_title_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="日出" />

        <TextView
            android:id="@+id/item_3_message_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_3_title_1"
            app:layout_constraintStart_toStartOf="@+id/item_3_title_1"
            app:layout_constraintTop_toBottomOf="@+id/item_3_title_1"
            tools:text="西北风2级" />

        <TextView
            android:id="@+id/item_3_message_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_3_title_2"
            app:layout_constraintStart_toStartOf="@+id/item_3_title_2"
            app:layout_constraintTop_toBottomOf="@+id/item_3_title_2"
            tools:text="06:00" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_4_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/item_4_title_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="日落" />

        <TextView
            android:id="@+id/item_4_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_4_title_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="温度" />

        <TextView
            android:id="@+id/item_4_message_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_4_title_1"
            app:layout_constraintStart_toStartOf="@+id/item_4_title_1"
            app:layout_constraintTop_toBottomOf="@+id/item_4_title_1"
            tools:text="20:00" />

        <TextView
            android:id="@+id/item_4_message_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_4_title_2"
            app:layout_constraintStart_toStartOf="@+id/item_4_title_2"
            app:layout_constraintTop_toBottomOf="@+id/item_4_title_2"
            tools:text="50%" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_5_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/item_5_title_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="降水量" />

        <TextView
            android:id="@+id/item_5_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_5_title_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="花粉浓度" />

        <TextView
            android:id="@+id/item_5_message_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_5_title_1"
            app:layout_constraintStart_toStartOf="@+id/item_5_title_1"
            app:layout_constraintTop_toBottomOf="@+id/item_5_title_1"
            tools:text="5毫米" />

        <TextView
            android:id="@+id/item_5_message_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/item_5_title_2"
            app:layout_constraintStart_toStartOf="@+id/item_5_title_2"
            app:layout_constraintTop_toBottomOf="@+id/item_5_title_2"
            tools:text="较低" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>