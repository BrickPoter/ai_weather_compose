<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="618dp"
    android:layout_height="80dp"
    android:gravity="center_vertical">

    <TextView
        android:text="@string/time"
        android:id="@+id/item_text_time"
        android:layout_width="104dp"
        android:layout_height="50dp"
        style="@style/Content_1_Regular"
        android:alpha="0.6"
        android:textColor="@color/text_content_transparent_80"/>


    <TextView
        android:text="50%"
        android:id="@+id/item_text_probability"
        android:layout_width="88dp"
        android:layout_height="50dp"
        android:gravity="end"
        android:visibility="invisible"
        style="@style/Content_1_Regular"
        android:textColor="@color/text_rainy_probability"
        android:layout_marginStart="12dp"/>

    <ImageView
        android:src="@drawable/clear_partly_cloudy_day"
        android:id="@+id/item_image_icon"
        android:layout_width="108dp"
        android:layout_height="80dp"
        android:layout_marginStart="8dp"/>

    <TextView
        android:text="@string/condition"
        android:id="@+id/item_text_condition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        style="@style/Content_1_Regular"
        android:alpha="0.6"
        android:textColor="@color/text_content_transparent_80"/>

    <!-- 占位空白View，把后面控件挤到右边 -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:text="22°/20°"
        android:id="@+id/item_text_temp"
        android:gravity="end"
        android:layout_width="128dp"
        android:layout_height="50dp"
        style="@style/Content_1_Regular"
        android:alpha="0.6"
        android:textColor="@color/text_content_transparent_80"/>

</LinearLayout>