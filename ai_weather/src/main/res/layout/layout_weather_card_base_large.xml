<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="730dp"
    android:layout_height="1064dp"
    android:background="@drawable/clear">

    <com.mosi.mosc.launcher.ai_weather.ui.CardHeaderLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/image_weather"
        android:layout_width="450dp"
        android:layout_height="388dp"
        android:layout_marginStart="104dp"
        android:layout_marginTop="132dp"
        android:src="@drawable/clear_partly_cloudy_day"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="480dp"
        android:layout_height="160dp"
        android:layout_marginStart="180dp"
        android:layout_marginTop="492dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:text="@string/highestTemp"
            android:id="@+id/text_current_temp"
            android:layout_width="240dp"
            android:layout_height="160dp"
            style="@style/Title_2_Regular"
            android:textColor="@color/Fill_Always_Dark"
            android:alpha="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:text="@string/temp_high_low"
            android:id="@+id/text_temp_high_low"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:layout_marginStart="200dp"
            android:layout_marginTop="24dp"
            style="@style/Content_2_Regular"
            android:textColor="@color/Fill_Always_Dark"
            android:alpha="0.6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:text="@string/condition"
            android:id="@+id/text_temp_info"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginStart="200dp"
            android:layout_marginTop="84dp"
            style="@style/Content_2_Regular"
            android:textColor="@color/Fill_Always_Dark"
            android:alpha="0.6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.mosi.mosc.launcher.ai_weather.ui.ExtraInfoRecycler
        android:id="@+id/extra_info"
        android:layout_width="650dp"
        android:layout_height="300dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="720dp"
        android:background="@drawable/bg_rect_extra_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>