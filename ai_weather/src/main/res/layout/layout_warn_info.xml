<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/alert_icon"
        android:layout_width="34dp"
        android:layout_height="28dp"
        android:alpha="0.8"
        android:src="@drawable/alert_blue"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <TextView
        android:id="@+id/title"
        android:text="@string/alert_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Content_1_Regular"
        android:alpha="0.8"
        android:minWidth="60dp"
        android:textColor="@color/text_content_transparent_80"
        app:layout_constraintStart_toEndOf="@id/alert_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/content"
        android:text="@string/alert_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Content_4_Regular"
        android:alpha="0.8"
        android:minWidth="60dp"
        android:textColor="@color/text_alert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

</androidx.constraintlayout.widget.ConstraintLayout>