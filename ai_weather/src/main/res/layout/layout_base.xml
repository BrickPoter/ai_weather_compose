<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/base_layout"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/image_nav"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/image_nav"
        app:layout_constraintStart_toEndOf="@+id/image_nav"
        app:layout_constraintTop_toTopOf="@+id/image_nav"
        tools:text="龙泉驿区" />

    <TextView
        android:id="@+id/text_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#80000000"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/image_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_nav"
        tools:text="今天下午" />

    <ImageView
        android:id="@+id/image_temp"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="@+id/text_time"
        app:layout_constraintTop_toBottomOf="@+id/text_time" />

    <TextView
        android:id="@+id/text_height_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textSize="34sp"
        android:textColor="#80000000"
        app:layout_constraintStart_toStartOf="@+id/image_nav"
        app:layout_constraintTop_toBottomOf="@+id/image_nav"
        tools:text="24°" />

    <TextView
        android:id="@+id/text_low_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="32sp"
        android:textColor="#80000000"
        app:layout_constraintBottom_toBottomOf="@+id/text_height_temp"
        app:layout_constraintStart_toEndOf="@+id/text_height_temp"
        app:layout_constraintTop_toTopOf="@+id/text_height_temp"
        tools:text="21°" />

    <TextView
        android:id="@+id/text_temp_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#80000000"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/text_height_temp"
        app:layout_constraintTop_toBottomOf="@+id/text_height_temp"
        tools:text="多云转雷阵雨" />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/layout_future"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_temp_desc">

        <LinearLayout
            android:id="@+id/layout_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_item_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="周四" />

            <ImageView
                android:id="@+id/image_item_1"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/text_item_probability_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="30dp"
                tools:text="80%" />

            <TextView
                android:id="@+id/text_item_temp_height_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="25℃" />

            <TextView
                android:id="@+id/text_item_temp_low_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="30dp"
                tools:text="22℃" />

            <TextView
                android:id="@+id/text_item_temp_des_1"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                tools:text="多云转晴" />
        </LinearLayout>

        <LinearLayout
