<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 内部透明，只保留描边 -->
    <solid android:color="@android:color/transparent" />

    <!-- 黑色描边，透明度 0.9 -->
    <stroke
        android:width="3dp"
        android:color="#E6000000" />

    <!-- 整体尺寸 19dp x 19dp -->
    <size
        android:width="19dp"
        android:height="19dp" />

</shape>